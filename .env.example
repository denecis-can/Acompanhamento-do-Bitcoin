# Copie para .env e preencha. O .env NÃO vai para o git.

# true = demonstração: nenhuma API externa é chamada, dados sintéticos e faixa de aviso no topo.
# Não precisa de nenhuma chave. Usa um banco separado (btc_dashboard_demo.db).
DEMO_MODE=false

# Obrigatória para os cards de macro (grátis em https://fredaccount.stlouisfed.org/apikeys)
FRED_API_KEY=

# Fluxos dos ETFs de BTC à vista (https://sosovalue.com/developer/dashboard → Apply your Key).
# Limite: 20 req/min e 100 mil/mês por chave; o dashboard usa ~850/mês.
# Sem chave, o card usa a importação manual em data/farside_import.html ou .csv (ver README).
SOSOVALUE_API_KEY=

# Caminho do banco SQLite (cache + histórico)
DATABASE_PATH=data/btc_dashboard.db

# Nível de log: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# HTTP
HTTP_TIMEOUT_SECONDS=10
HTTP_MAX_RETRIES=3

# Intervalos de coleta (segundos)
INTERVAL_PRICE=60
INTERVAL_DERIVATIVES=300
INTERVAL_VOLATILITY=900
INTERVAL_SENTIMENT=3600
INTERVAL_MACRO=43200
INTERVAL_ETF=43200
INTERVAL_STABLECOINS=21600
INTERVAL_MEMPOOL=600
INTERVAL_ONCHAIN=21600
INTERVAL_NEWS=900
